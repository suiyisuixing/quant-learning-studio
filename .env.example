# 复制为 .env，只在自己的部署目录填写；不要提交 .env。
# 没有配置时，界面明确显示未连接，不用假结果替代。
QLAB_AI_KEY=
QLAB_AI_URL=https://api.deepseek.com/chat/completions
QLAB_AI_MODEL=deepseek-chat
QLAB_CN_TOKEN=
QLAB_US_KEY=
# 本地保持默认。对外部署须按docs/DEPLOYMENT.md核对。
QLAB_HOSTS=127.0.0.1,localhost,testserver
# QLAB_ORIGIN=https://your-owned-host.example
# QLAB_SECURE_COOKIE=1
# QLAB_DB=/absolute/private/path/qlab.db
